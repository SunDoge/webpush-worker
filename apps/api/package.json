{
  "name": "@webpush-worker/api",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "check": "tsc --noEmit -p tsconfig.json",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "gen-schema": "node scripts/gen-shema.ts",
    "db:init": "node scripts/init-db.ts",
    "db:inspect": "node scripts/inspect-db.ts",
    "db:apply:local": "wrangler d1 migrations apply webpush-db --local",
    "db:apply:remote": "wrangler d1 migrations apply webpush-db --remote"
  },
  "dependencies": {
    "@hono/standard-validator": "^0.2.3",
    "@sundoge/kysely-d1": "^0.2.0",
    "hono": "^4.12.27",
    "kysely": "^0.29.2",
    "valibot": "^1.4.2",
    "@webpush-worker/shared": "workspace:*",
    "webpush-webcrypto": "^1.0.5",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.0",
    "better-sqlite3": "^12.11.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "~5.9.3",
    "wrangler": "4.106.0"
  }
}
